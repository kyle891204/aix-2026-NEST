# VITE_* values are public browser configuration. Never put API keys/tokens here.
# API calls always use the same-origin /api/v1 proxy (Vite dev server, Vercel rewrite).
# Demo fallback: show app screens without login. Keep false outside demos.
VITE_DEMO_GUEST=false
# Only used by the local Vite dev-server proxy.
BACKEND_PROXY_TARGET=http://127.0.0.1:8081
