# Copy to backend/.env. Read automatically when running from backend/.
# Use KEY=value without quotes or export. Restart the backend after editing.
SERVER_PORT=8081
# Google Cloud > OAuth client > Web application (public client ID, no client secret needed).
# Paste the complete Client ID, including its existing .apps.googleusercontent.com suffix exactly once.
GOOGLE_CLIENT_ID=
# Local HTTP only. Production must use the default true.
AUTH_COOKIE_SECURE=false
# Both local Vite URLs must be allowed for login POST requests through the proxy.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LMS_API_BASE_URL=https://learning.hanyang.ac.kr/api/v1
LMS_API_TOKEN=
# Only for an explicitly enabled shared-account demo. Never use the Canvas token as this password.
# SPRING_PROFILES_ACTIVE=prod,lms-demo
LMS_DEMO_PASSWORD=
