# 해당 파일 backend/.env 위치로 복사하셔서 사용하시면 됩니다.
SERVER_PORT=8081
# Google Client ID의 경우 아래 방법으로 발급받아서 .env에 붙여넣으시면 됩니다.
# Google Cloud > OAuth client > Web application > 생성 후 Client Key 발급 > 하단에 키값 붙여넣기
GOOGLE_CLIENT_ID=
AUTH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LMS API TOKEN은 본인 LMS 설정 가셔서 api키 발급받아서 붙여넣으시면 됩니다
LMS_API_BASE_URL=https://learning.hanyang.ac.kr/api/v1
LMS_API_TOKEN=

# 비밀번호는 자유롭게 설정하세용
LMS_DEMO_PASSWORD=

# 로컬에서 돌아가는 경우에만 위 api키가 필요합니다. 배포된 사이트의 경우 환경변수로 api키를 숨겨서 올려뒀습니다..